/* What macOS shows for a notification pushed while the app is closed. The
   push service sends these keys, never text, and the value that fills each.
   Keep the keys and the words as wallet_core's app_id.arb has them:
   test/mac_push_strings_test.dart checks it. */

"desktopNotificationReceivedTitle" = "%@ diterima";
"desktopNotificationReceivedBody" = "Di %@";
"desktopNotificationIncomingTitle" = "%@ akan masuk";
"desktopNotificationIncomingBody" = "Dijadwalkan masuk ke %@";

/* What happens to a multisig's proposal. Where a string takes two values,
   they are numbered in the order the push service sends them. */

"desktopNotificationProposalNewTitle" = "Proposal baru";
"desktopNotificationProposalSignedTitle" = "Proposal ditandatangani: %1$@ dari %2$@";
"desktopNotificationProposalReadyTitle" = "Proposal siap dieksekusi";
"desktopNotificationProposalExecutedTitle" = "Proposal dieksekusi";
"desktopNotificationProposalFailedTitle" = "Eksekusi proposal gagal";
"desktopNotificationProposalCancelledTitle" = "Proposal dibatalkan";
"desktopNotificationProposalRemovedTitle" = "Proposal dihapus";
"desktopNotificationProposalCreatedBody" = "Kirim %1$@ dari %2$@";
"desktopNotificationProposalOtherBody" = "Di %@";
