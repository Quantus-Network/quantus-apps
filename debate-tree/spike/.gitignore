# Dependencies
node_modules/

# Secrets (OPENROUTER_API_KEY etc. — never commit)
.env

# Local PGlite databases (pgdata, pgdata-demo, ...) — reseeded on first run
pgdata*/

# Stray process logs
nohup.out
*.log

# The repo root ignores *.lock (Flutter convention); we DO want npm's lockfile
!package-lock.json
