<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/swap_live_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/swap_live_tile"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_swap_live"
            android:tint="#FFFF6B35" />

        <TextView
            android:id="@+id/swap_live_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFE8E6E0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/swap_live_eta"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/swap_live_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFF6B35"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/swap_live_ago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="gone">

            <Chronometer
                android:id="@+id/swap_live_ago_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/swap_live_ago_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#FFE8E6E0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/swap_live_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <FrameLayout
        android:id="@+id/swap_live_progress_wrap"
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:layout_marginTop="8dp">

        <ProgressBar
            android:id="@+id/swap_live_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="center_vertical"
            android:max="1000"
            android:progressBackgroundTint="#29E8E6E0"
            android:progressTint="#FFFF6B35" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <ImageView
                android:id="@+id/swap_live_tick_25"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#73FFFFFF"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <ImageView
                android:id="@+id/swap_live_tick_50"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#73FFFFFF"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <ImageView
                android:id="@+id/swap_live_tick_75"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#73FFFFFF"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="164"
            android:orientation="vertical">

            <TextView
                android:id="@+id/swap_live_from_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE8E6E0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/swap_live_from_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/swap_live_from_symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#FFE8E6E0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="#29E8E6E0"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="182"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="0dp">

            <TextView
                android:id="@+id/swap_live_to_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE8E6E0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/swap_live_to_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/swap_live_to_symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#FFE8E6E0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="#29E8E6E0"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="294"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="0dp">

            <TextView
                android:id="@+id/swap_live_chain_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE8E6E0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/swap_live_chain_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/swap_live_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#FFFF6B35"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
